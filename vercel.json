{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["cdg1"],
  "functions": {
    "api/main.js": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/Main.dc.html", "destination": "/site", "permanent": false },
    { "source": "/Cockpit.dc.html", "destination": "/comptoir", "permanent": false },
    { "source": "/Parcours.dc.html", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/main?route=:path*" },
    { "source": "/comptoir", "destination": "/comptoir/index.html" },
    { "source": "/comptoir/:path*", "destination": "/comptoir/index.html" },
    { "source": "/r/:token", "destination": "/client/index.html" },
    { "source": "/recu/:token", "destination": "/client/index.html" },
    { "source": "/paiement/:id", "destination": "/client/index.html" },
    { "source": "/film", "destination": "/film/index.html" },
    { "source": "/atelier", "destination": "/atelier/index.html" },
    { "source": "/direct", "destination": "/direct/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/(comptoir|r|recu|paiement|client)(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' https://checkout.stripe.com; object-src 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/(film|atelier|direct)(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/support.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
