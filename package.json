{
  "name": "larchitecte",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && node scripts/postbuild.mjs",
    "start": "node scripts/dev.mjs --dist",
    "test": "node --test --test-reporter=spec \"tests/unit/*.test.js\" \"tests/api/*.test.js\"",
    "test:pg": "node scripts/test-pg.mjs",
    "test:e2e": "node tests/e2e/run.mjs; d=$?; node tests/e2e/prod.mjs && exit $d",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.10.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
